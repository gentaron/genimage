# The AI that writes the headline, keywords and Eureka's comment.
# Tried in this order; the first one that answers wins. With nothing set,
# the free keyless Pollinations API is used, and if that fails too the
# browser's offline extractor takes over. The app works either way.

# Paid, best quality. Tried first when set.
ANTHROPIC_API_KEY=
# THUMB_MODEL=claude-opus-5-5

# Free: get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Free and keyless. A token only raises the rate limit.
# POLLINATIONS_TOKEN=
# POLLINATIONS_MODEL=openai
# POLLINATIONS_DISABLED=1
