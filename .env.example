# ---------------------------------------------------------------------------
# Backends. None of these are required: with no configuration at all the studio
# falls back to the offline preview renderer, which needs no GPU and no network.
# ---------------------------------------------------------------------------

# ComfyUI — the only backend that actually loads your LoRA stack.
COMFYUI_URL=http://127.0.0.1:8188
# How long to wait for one render before giving up (ms).
COMFYUI_TIMEOUT_MS=600000

# Hugging Face Inference. A free account token works.
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Used when the selected checkpoint has no Hub repo of its own.
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Pollinations — free and keyless; a token only raises the rate limit.
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux

# ---------------------------------------------------------------------------
# Prompt Helper. Optional: without these it uses the built-in tag lexicon.
# Any OpenAI-compatible chat completions endpoint works.
# ---------------------------------------------------------------------------
PROMPT_HELPER_URL=
PROMPT_HELPER_KEY=
PROMPT_HELPER_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Instance limits
# ---------------------------------------------------------------------------
# Where generated images and job history are written.
GENIMAGE_DATA_DIR=./data
# Jobs kept in history; older ones are deleted along with their images.
GENIMAGE_MAX_HISTORY=500
# Renders running at once. Raise only if the GPU has the VRAM for it.
GENIMAGE_CONCURRENCY=1
GENIMAGE_MAX_BATCH=8
GENIMAGE_MAX_LORAS=6
# Set to 1 on a shared instance to block explicit content entirely.
GENIMAGE_SFW_ONLY=0
