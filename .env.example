# ---------------------------------------------------------------------------
# Backends. None are required. With no configuration the studio uses
# Pollinations (free, keyless) and falls back to an offline renderer.
#
# Only fal.ai, Replicate and ComfyUI actually load LoRA weights.
# ---------------------------------------------------------------------------

# --- Cloud, loads your LoRA stack, paid per second of GPU time --------------
# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
# Any fal app that accepts `loras: [{ path, scale }]`.
FAL_MODEL=fal-ai/lora
# Set to 0 to turn off fal's own safety checker.
FAL_SAFETY_CHECKER=1

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# `owner/name` runs the default version; `owner/name:version` pins one.
REPLICATE_MODEL=lucataco/sdxl-lora

# Cloud backends fetch weights over HTTP, so they need a public URL per model.
# Keys are catalog ids from src/lib/catalog.ts.
# GENIMAGE_WEIGHTS={"coco-illustrious-noobxl-style":"https://…/coco.safetensors","shexyo-v3":"https://…/shexyo_v3.safetensors","trt-style-illustrious":"https://…/trt.safetensors","hyper-sdxl":"https://…/Hyper-SDXL-8steps-lora.safetensors"}

# --- Self-hosted, loads your LoRA stack, free but needs your own GPU --------
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=600000

# --- Cloud, no LoRA support -------------------------------------------------
# Hugging Face Inference — https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Pollinations is free and keyless; a token only raises the rate limit.
# The token is only ever put on an image URL (and so exposed to the browser)
# when POLLINATIONS_TOKEN_IN_URL=1.
POLLINATIONS_TOKEN=
POLLINATIONS_TOKEN_IN_URL=0
POLLINATIONS_MODEL=flux

# ---------------------------------------------------------------------------
# Prompt Helper. Optional: without these it uses the built-in tag lexicon.
# Any OpenAI-compatible chat completions endpoint works.
# ---------------------------------------------------------------------------
PROMPT_HELPER_URL=
PROMPT_HELPER_KEY=
PROMPT_HELPER_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Instance settings
# ---------------------------------------------------------------------------
# Signs the provider handles the browser round-trips. Any random string.
# Falls back to a value derived from your provider keys if unset.
GENIMAGE_SECRET=

# Storage for image bytes: auto | netlify | filesystem | memory.
# Auto picks Netlify Blobs on Netlify and the local filesystem elsewhere.
# GENIMAGE_STORAGE=
GENIMAGE_DATA_DIR=./data
GENIMAGE_BLOB_STORE=genimage

GENIMAGE_MAX_BATCH=8
GENIMAGE_MAX_LORAS=6
# Set to 1 on a shared instance to block explicit content entirely.
GENIMAGE_SFW_ONLY=0
